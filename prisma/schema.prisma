// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum Role {
  PLAYER
  ADMIN
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

model Registration {
  id           String     @id @default(uuid())
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId String
  team         Team       @relation(fields: [teamId], references: [id])
  teamId       String
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, teamId]) // Ensure a team can register only once per tournament
  @@map("registrations")
}

model Player {
  id        String   @id @default(uuid())
  nickname  String
  gameId    String   @unique
  team      Team?    @relation(fields: [teamId], references: [id])
  teamId    String?
  createdAt DateTime @default(now())

  @@map("players")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String
  username     String         @unique
  role         Role           @default(PLAYER)
  createdAt    DateTime       @default(now())
  teams        Team[]
  RefreshToken RefreshToken[]

  @@map("users")
}

model RefreshToken {
  token      String   @unique
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  expiryDate DateTime

  @@map("refresh_tokens")
}

model Team {
  id            String         @id @default(uuid())
  name          String
  creator       User           @relation(fields: [userId], references: [id])
  userId        String
  players       Player[]
  registrations Registration[]
  createdAt     DateTime       @default(now())
  Match         Match[]
  MatchTeam     MatchTeam[]
  Score         Score[]

  @@map("teams")
}

model Tournament {
  id            String           @id @default(uuid())
  name          String
  game          Game             @relation(fields: [gameId], references: [id])
  gameId        String
  status        TournamentStatus @default(UPCOMING)
  startDate     DateTime
  endDate       DateTime?
  maxTeams      Int
  registrations Registration[]
  matches       Match[]

  @@map("tournaments")
}

model Game {
  id         String       @id @default(uuid())
  name       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Tournament Tournament[]

  @@map("games")
}

model Match {
  id           String      @id @default(uuid())
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])
  tournamentId String
  teams        MatchTeam[] // Relasi ke tabel junction
  winner       Team?       @relation(fields: [winnerId], references: [id])
  winnerId     String?
  scheduledAt  DateTime
  status       MatchStatus @default(UPCOMING)
  scores       Score[]

  @@map("matches")
}

// Tabel junction untuk relasi many_to-many Match-Team
model MatchTeam {
  match    Match   @relation(fields: [matchId], references: [id])
  matchId  String
  team     Team    @relation(fields: [teamId], references: [id])
  teamId   String
  isWinner Boolean @default(false) // Flag pemenang

  @@id([matchId, teamId]) // Composite primary key
  @@map("match_teams")
}

model Score {
  id      String @id @default(uuid())
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String
  team    Team   @relation(fields: [teamId], references: [id])
  teamId  String
  points  Int // Score per tim

  @@map("scores")
}
